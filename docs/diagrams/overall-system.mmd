flowchart LR
    subgraph Inputs
        IN[Uploads requirements and wheels]
        CFG[Config python versions policy strategy]
    end

    PLAN[Go planner<br/>DAG runtime pack wheel repair]
    Q[Queue backend<br/>file Redis Kafka]
    subgraph Control
        CP[Control plane API]
        DB[(Postgres<br/>plans builds attempts events logs workers)]
        HUB[Log hub]
        HINTS[Hint catalog]
        METRICS[Metrics and readiness KPIs]
    end
    subgraph Storage
        ZOT[CAS registry Zot]
        MINIO[Object store wheelhouse and inputs]
    end
    subgraph Builder
        WKR[Go worker<br/>heartbeat + settings overlay]
        RUN[Podman runner]
        REC[Recipes pack runtime repair]
        BASE[Cached builder and worker UBI8 bases]
    end
    UI[React UI]

    IN --> CP
    CP --> DB
    CP --> HINTS
    HINTS --> PLAN
    CFG --> PLAN
    PLAN --> Q
    PLAN -. cache check .-> ZOT
    Q --> WKR
    WKR -->|fetch artifacts| ZOT
    WKR -->|push artifacts| ZOT
    WKR --> RUN
    BASE --> RUN
    RUN -->|build outputs| MINIO
    WKR -->|status attempts events manifest| CP
    WKR -->|log chunks| CP
    WKR -->|worker heartbeats| CP
    CP --> HUB
    HUB -->|live logs| UI
    CP --> METRICS
    CP <--> UI
